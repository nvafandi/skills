{
  "name": "powershell-sandbox-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server (stdio) untuk menjalankan script PowerShell di sandbox terisolasi ringan: working dir khusus, env minimal, timeout, log, dan penjaga path.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "powershell-sandbox-mcp": "src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/smoke.js",
    "build:podman": "podman build -t localhost/powershell-sandbox-mcp:latest -f Dockerfile ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  }
}