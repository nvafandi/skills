{
  "min_session_length": 10,
  "extraction_threshold": "medium",
  "auto_approve": false,
  "learned_skills_path": "~/.config/opencode/skills/learned/",
  "patterns_to_detect": [
    "error_resolution",
    "user_corrections",
    "workarounds",
    "debugging_techniques",
    "project_specific",
    "security_violations"
  ],
  "ignore_patterns": [
    "simple_typos",
    "one_time_fixes",
    "external_api_issues"
  ],
  "security_rules": {
    "never_store_passwords": true,
    "never_log_sudo_passwords": true,
    "warn_on_password_sharing": true,
    "auto_activate_on_credential_detection": true,
    "scan_every_message": true,
    "blocked_patterns": [
      "sudo password\\s*[=:]",
      "password\\s*[=:]\\s*\\S+",
      "api_key\\s*[=:]",
      "API_KEY\\s*[=:]",
      "token\\s*[=:]\\s*\\S+",
      "db_pass\\s*[=:]",
      "-----BEGIN.*PRIVATE KEY-----"
    ]
  }
}